# ============================================================
# BichoFit — .env de PRODUCCIÓN (VPS) con Postgres externo
# Colócalo en la raíz del repo en el servidor, ajusta y:
#   docker compose up -d
# ============================================================

APP_NAME=BichoFit
APP_ENV=production
APP_KEY=base64:REEMPLAZAR
# ↑ genera una con:
#   docker compose run --rm app php artisan key:generate --show

APP_DEBUG=false
APP_URL=https://bichofit.tudominio.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# FrankenPHP/Caddy: tu dominio con TLS automático (puertos 80/443 abiertos)
SERVER_NAME=bichofit.tudominio.com:443

# ------------------------------------------------------------
# Base de datos EXTERNA (la URL interna que te dio el servidor)
# ------------------------------------------------------------
# Opción A — una sola línea (recomendada si te dan la URL):
DB_URL=postgres://usuario:contraseña@10.0.0.5:5432/bichofit

# Opción B — por partes (usa esta SI NO usas DB_URL; comentar la de arriba):
# DB_CONNECTION=pgsql
# DB_HOST=10.0.0.5
# DB_PORT=5432
# DB_DATABASE=bichofit
# DB_USERNAME=usuario
# DB_PASSWORD=contraseña

# Sesiones/caché/cola en la misma BD (tablas ya migradas)
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
CACHE_STORE=database

LOG_CHANNEL=stderr
LOG_LEVEL=error
